# Optional local SQLite database path. Relative paths resolve from the project root.
DATABASE_PATH=data/outreach.sqlite3

# Safe mode remains enabled. This milestone does not send email or DMs.
DEMO_MODE=true

# Deterministic qualification thresholds (inclusive follower boundaries).
MIN_FOLLOWERS=5000
MAX_FOLLOWERS=100000
MIN_ENGAGEMENT_RATE=1.0

# Milestone 4 AI generation configuration. Add a real key only to your local .env.
LLM_PROVIDER=groq
LLM_MODEL=
# GROQ_API_KEY=

# Milestone 5 SMTP configuration foundation. No SMTP connection is opened yet.
# To enable authenticated live configuration later, fill all four identity/credential values.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=20
